# Copy to .env.local for local development. On Vercel, set these in Project → Settings → Environment Variables.

# Postgres connection string (Neon). If empty, the app uses a local JSON file in ./data (dev only).
DATABASE_URL=

# Secret for signing session cookies. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# First Director (ADMIN) account, used when initializing a brand-new database or by the migration script.
ADMIN_EMAIL=
ADMIN_PASSWORD=
